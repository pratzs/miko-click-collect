{% comment %}
  Miko Click & Collect — Pickup Selector
  Add this block to the cart page. Customers toggle pickup,
  select a location, and the choice is saved as cart attributes
  that flow through to the order.
{% endcomment %}

{{ 'click-collect.css' | asset_url | stylesheet_tag }}

<div id="miko-cc" class="miko-cc" data-app-url="{{ block.settings.app_url }}">
  {%- if request.page_type != 'cart' -%}
    <div class="miko-cc__setup-notice">
      <strong>Miko Click &amp; Collect</strong>
      <span>
        This block works on the <strong>cart page</strong>.<br>
        Move it to your Cart template in the theme editor.
      </span>
    </div>
  {%- else -%}
    <div id="miko-cc-loading" class="miko-cc__loading">
      Loading pickup locations…
    </div>

    <div id="miko-cc-widget" class="miko-cc__hidden">
      <!-- Toggle -->
      <div id="miko-cc-toggle" class="miko-cc__toggle" role="button" tabindex="0" aria-pressed="false">
        <div class="miko-cc__toggle-icon">🛍️</div>
        <div class="miko-cc__toggle-text">
          <p class="miko-cc__toggle-title">Collect in-store (free)</p>
          <p class="miko-cc__toggle-sub">Skip shipping — pick up your order from one of our locations.</p>
        </div>
        <div class="miko-cc__toggle-check">
          <svg width="14" height="14" viewBox="0 0 20 20" fill="white" style="display:none" id="miko-cc-checkmark">
            <path d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"/>
          </svg>
        </div>
      </div>

      <!-- Expanded panel -->
      <div id="miko-cc-panel" class="miko-cc__panel miko-cc__hidden">
        <select id="miko-cc-select" class="miko-cc__select" aria-label="Select pickup location"></select>
        <div id="miko-cc-card" class="miko-cc__location-card"></div>
        <div class="miko-cc__info">
          📧 You'll receive an email when your order is ready to collect. Bring your order number or confirmation email.
        </div>
      </div>
    </div>

    <div id="miko-cc-empty" class="miko-cc__hidden"></div>
  {%- endif -%}
</div>

<script>
(function() {
  var container = document.getElementById('miko-cc');
  if (!container) return;
  var appUrl = container.getAttribute('data-app-url');
  if (!appUrl) return;

  var shop = window.Shopify && Shopify.shop ? Shopify.shop : '';
  if (!shop) return;

  var locations = [];
  var selectedIdx = 0;
  var isActive = false;

  var loadingEl = document.getElementById('miko-cc-loading');
  var widgetEl = document.getElementById('miko-cc-widget');
  var emptyEl = document.getElementById('miko-cc-empty');
  var toggleEl = document.getElementById('miko-cc-toggle');
  var panelEl = document.getElementById('miko-cc-panel');
  var selectEl = document.getElementById('miko-cc-select');
  var cardEl = document.getElementById('miko-cc-card');
  var checkmark = document.getElementById('miko-cc-checkmark');

  function show(el) { el && el.classList.remove('miko-cc__hidden'); }
  function hide(el) { el && el.classList.add('miko-cc__hidden'); }

  function renderCard() {
    var loc = locations[selectedIdx];
    if (!loc || !cardEl) return;

    var days = { mon: 'Mon', tue: 'Tue', wed: 'Wed', thu: 'Thu', fri: 'Fri', sat: 'Sat', sun: 'Sun' };
    var todayKey = ['sun','mon','tue','wed','thu','fri','sat'][new Date().getDay()];
    var h = loc.hours && loc.hours[todayKey];
    var hoursText = h ? (h.closed ? 'Closed today' : 'Today: ' + h.open + ' – ' + h.close) : '';

    var prepText = loc.prepTimeMinutes < 60 ? loc.prepTimeMinutes + ' min'
      : loc.prepTimeMinutes === 60 ? '1 hour'
      : loc.prepTimeMinutes < 1440 ? Math.round(loc.prepTimeMinutes / 60) + ' hours'
      : 'Next day';

    var html = '<p class="miko-cc__location-name">' + escHtml(loc.name) + '</p>';
    var addr = [loc.address, loc.city, loc.postcode].filter(Boolean).join(', ');
    if (addr) html += '<p class="miko-cc__location-detail">📍 ' + escHtml(addr) + '</p>';
    if (hoursText) html += '<p class="miko-cc__location-detail">🕐 ' + escHtml(hoursText) + '</p>';
    html += '<p class="miko-cc__location-detail">⏱️ Ready in ' + escHtml(prepText) + '</p>';
    if (loc.phone) html += '<p class="miko-cc__location-detail">📞 ' + escHtml(loc.phone) + '</p>';
    if (loc.collectionInstructions) {
      html += '<div class="miko-cc__location-instructions">' + escHtml(loc.collectionInstructions) + '</div>';
    }
    cardEl.innerHTML = html;
  }

  function escHtml(s) {
    var d = document.createElement('div');
    d.textContent = s;
    return d.innerHTML;
  }

  function updateCartAttributes(attrs) {
    return fetch('/cart/update.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ attributes: attrs })
    });
  }

  function activate() {
    isActive = true;
    toggleEl.classList.add('miko-cc__toggle--active');
    toggleEl.setAttribute('aria-pressed', 'true');
    checkmark.style.display = 'block';
    show(panelEl);

    var loc = locations[selectedIdx];
    updateCartAttributes({
      miko_pickup_method: 'click_and_collect',
      miko_location_id: loc.id,
      miko_location_name: loc.name
    });
  }

  function deactivate() {
    isActive = false;
    toggleEl.classList.remove('miko-cc__toggle--active');
    toggleEl.setAttribute('aria-pressed', 'false');
    checkmark.style.display = 'none';
    hide(panelEl);

    updateCartAttributes({
      miko_pickup_method: '',
      miko_location_id: '',
      miko_location_name: ''
    });
  }

  if (toggleEl) {
    toggleEl.addEventListener('click', function() {
      if (isActive) deactivate(); else activate();
    });
    toggleEl.addEventListener('keydown', function(e) {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        if (isActive) deactivate(); else activate();
      }
    });
  }

  if (selectEl) {
    selectEl.addEventListener('change', function() {
      selectedIdx = parseInt(selectEl.value, 10) || 0;
      renderCard();
      if (isActive) {
        var loc = locations[selectedIdx];
        updateCartAttributes({
          miko_pickup_method: 'click_and_collect',
          miko_location_id: loc.id,
          miko_location_name: loc.name
        });
      }
    });
  }

  fetch(appUrl + '/api/public/locations?shop=' + encodeURIComponent(shop))
    .then(function(r) { return r.json(); })
    .then(function(data) {
      locations = data.locations || [];
      hide(loadingEl);

      if (locations.length === 0) return;

      show(widgetEl);

      if (selectEl && locations.length > 1) {
        locations.forEach(function(loc, i) {
          var opt = document.createElement('option');
          opt.value = i;
          opt.textContent = loc.name + (loc.city ? ' — ' + loc.city : '');
          selectEl.appendChild(opt);
        });
      } else if (selectEl) {
        hide(selectEl);
      }

      renderCard();
    })
    .catch(function() {
      hide(loadingEl);
    });
})();
</script>

{% schema %}
{
  "name": "Click & Collect",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "app_url",
      "label": "App URL",
      "info": "Your Miko Click & Collect app URL (e.g. https://miko-click-collect-production.up.railway.app)"
    }
  ]
}
{% endschema %}
